#!/usr/bin/env bash
# SDLC Studio pre-push gate: the boundary lanes (release-rehearsal, revert-check, module-alone) bind here.
#
# git hands this hook one line per ref on stdin - `<local ref> <local sha> <remote ref> <remote
# sha>`. A tag ref is the RELEASE boundary, a branch ref is the PUSH boundary, and a deletion
# (all-zero local sha) runs no gate at all. `release` binds the same lanes as `push`, so a
# push carrying both a branch and a tag runs the gate ONCE, at `release`. One literal invocation
# per boundary below, so `tools/boundary_roster.py` can read which boundaries this hook binds
# without resolving a variable.
#
# The cost is announced BEFORE it is paid: the boundary gate runs the full suite plus the
# boundary lanes, minutes rather than seconds, and a guard whose cost arrives unannounced is one that
# gets killed and then bypassed (D0180 records the ruling to pay it on every push). The bypass
# is git's own, `git push --no-verify`, and every GATE refusal this hook makes names it. The
# red-CI refusal below (BG0642) deliberately does not: its route is the acknowledgement by run id.
set -uo pipefail
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
skill=".claude/skills/sdlc-studio/scripts"
zero="0000000000000000000000000000000000000000"
boundary=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue           # a deletion pushes nothing to gate
  case "$remote_ref" in
    refs/tags/*) boundary="release" ;;
    *) [ "$boundary" = "release" ] || boundary="push" ;;
  esac
done
[ -z "$boundary" ] && exit 0

# --- read the latest push-triggered Lint run on main BEFORE the gate (BG0642, D0181) -------
# A red main must be READ before the next push, not discovered two days later in a tab. The
# hook asks the forge for the latest COMPLETED push-triggered Lint run on main - never a
# scheduled corpus run, never Dependabot's - and refuses on any conclusion but success until
# that run's id is acknowledged, once, per clone. An unreadable or empty answer is named as
# such and never rendered as green; it does not block an offline push. Written against bash
# builtins, git, python3 and gh only, because the fixture PATH holds nothing else.
ack_file="sdlc-studio/.local/push-ack.json"
ci_json="$(gh run list --workflow Lint --branch main --event push --status completed --limit 1 --json databaseId,conclusion,url 2>/dev/null)"
ci_rc=$?
if [ "$ci_rc" -ne 0 ]; then
  echo "pre-push: CI state UNREAD: could not read the latest Lint run on main" >&2
else
  ci_read="$(python3 - "$ci_json" <<'PY' 2>/dev/null || echo "UNREAD"
import json, sys
try:
    runs = json.loads(sys.argv[1] or "[]") or []
except ValueError:
    print("UNREAD"); raise SystemExit(0)
if not isinstance(runs, list):
    print("UNREAD"); raise SystemExit(0)      # a number or an object is not a run list
if not runs:
    print("EMPTY"); raise SystemExit(0)
r = runs[0] if isinstance(runs[0], dict) else {}
if not str(r.get("databaseId", "")).strip():
    print("UNREAD"); raise SystemExit(0)      # no id to acknowledge against: never "already acknowledged" by an empty match
print("\t".join(str(r.get(k, "")) for k in ("databaseId", "conclusion", "url")))
PY
)"
  case "$ci_read" in
    EMPTY)  echo "pre-push: no completed Lint run on main to read" >&2 ;;
    UNREAD) echo "pre-push: CI state UNREAD: could not read the latest Lint run on main" >&2 ;;
    *)
      run_id="${ci_read%%	*}"; rest="${ci_read#*	}"; conclusion="${rest%%	*}"; run_url="${rest#*	}"
      if [ "$conclusion" != "success" ]; then
        acked="$(python3 - "$ack_file" <<'PY' 2>/dev/null
import json, os, sys
p = sys.argv[1]
print(json.load(open(p)).get("acknowledged", "") if os.path.exists(p) else "")
PY
)"
        if [ -n "${SDLC_PUSH_ACK_RED:-}" ] && [ "$SDLC_PUSH_ACK_RED" = "$run_id" ]; then
          if python3 - "$ack_file" "$run_id" <<'PY' 2>/dev/null
import json, os, sys
p = sys.argv[1]
os.makedirs(os.path.dirname(p), exist_ok=True)
json.dump({"acknowledged": sys.argv[2]}, open(p, "w"))
PY
          then
            echo "pre-push: red Lint run $run_id acknowledged and remembered for this clone" >&2
          else
            echo "pre-push: red Lint run $run_id acknowledged but the record could not be written at $ack_file - fix the path and push again" >&2
            exit 1
          fi
        elif [ "$acked" = "$run_id" ]; then
          echo "pre-push: red Lint run $run_id already acknowledged for this clone" >&2
        else
          echo "pre-push: the latest push-triggered Lint run on main concluded $conclusion and has not been read: run $run_id ($run_url)" >&2
          echo "  read it, then acknowledge it by id: SDLC_PUSH_ACK_RED=$run_id git push" >&2
          exit 1
        fi
      fi ;;
  esac
fi

# --- announce the cost, then pay it -------------------------------------------------------
cost="$(python3 tools/gate_timing.py estimate --suite "boundary-$boundary" --warn-seconds 0 2>/dev/null || true)"
if [ -z "$cost" ]; then
  # No run recorded for this boundary yet (the first push is the one this hook exists for): the
  # floor is the full suite's own recorded figure, and a literal when even that is absent.
  suite="$(python3 tools/gate_timing.py estimate --suite skill-tests --warn-seconds 0 2>/dev/null || true)"
  if [ -n "$suite" ]; then
    cost="boundary-$boundary: no run recorded yet - expect at least the full suite (${suite#skill-tests: expect }) plus release-rehearsal, revert-check and module-alone"
  else
    cost="boundary-$boundary: no run recorded yet - expect about ten minutes (the full suite plus release-rehearsal, revert-check and module-alone)"
  fi
fi
echo "pre-push: $cost. Bypass once with: git push --no-verify" >&2

# Scrubbed exactly as the commit hooks scrub their suite lanes, and for the same reason: git
# hands a pre-push hook the pushing repository's locations, and the gate's rehearsal lane builds
# git repositories of its own - unscrubbed, every one of them is steered at this clone. The
# scrub is written out on each invocation so the list is pinned where it is used. The gate's
# stdout is sent to stderr: git shows a pusher the hook's stderr, and the refusal below says
# "see the lane named above", so the lane name has to be on the stream the refusal is on.
t0=$SECONDS
if [ "$boundary" = "release" ]; then
  /usr/bin/env -u GIT_DIR -u GIT_COMMON_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
     -u GIT_INDEX_VERSION -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
     -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES -u GIT_DISCOVERY_ACROSS_FILESYSTEM \
     -u GIT_PREFIX python3 "$skill/gate.py" --boundary release 1>&2
  rc=$?
else
  /usr/bin/env -u GIT_DIR -u GIT_COMMON_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
     -u GIT_INDEX_VERSION -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
     -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES -u GIT_DISCOVERY_ACROSS_FILESYSTEM \
     -u GIT_PREFIX python3 "$skill/gate.py" --boundary push 1>&2
  rc=$?
fi
python3 tools/gate_timing.py record --suite "boundary-$boundary" --seconds "$((SECONDS - t0))" >/dev/null 2>&1 || true
if [ "$rc" -ne 0 ]; then
  echo "pre-push: the $boundary boundary gate refused this push - see the lane named above." >&2
  echo "  re-run: python3 $skill/gate.py --boundary $boundary" >&2
  echo "  bypass once (emergency only): git push --no-verify" >&2
  exit "$rc"
fi
exit 0
