#!/usr/bin/env bash
# SDLC Studio pre-push gate: the full suite binds at a push, the heavy lanes at a tag.
#
# git hands this hook one line per ref on stdin - `<local ref> <local sha> <remote ref> <remote
# sha>`. A tag ref is the RELEASE boundary, a branch ref is the PUSH boundary, and a deletion
# (all-zero local sha) runs no gate at all. A push runs the full suite ONCE plus the core gate
# lanes; `release` adds release-rehearsal, revert-check and module-alone, so a push carrying both
# a branch and a tag runs the gate ONCE, at `release`. One literal invocation per boundary below,
# so `tools/boundary_roster.py` can read which boundaries this hook binds without resolving a
# variable.
#
# The cost is announced BEFORE it is paid: minutes rather than seconds, and a guard whose cost
# arrives unannounced is one that gets killed and then bypassed (D0180 records the ruling to pay
# the full suite on every push). The bypass
# is git's own, `git push --no-verify`, and every GATE refusal this hook makes names it. The
# red-CI refusal below (BG0642) deliberately does not: its route is the acknowledgement by run id.
set -uo pipefail
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
skill=".claude/skills/sdlc-studio/scripts"
zero="0000000000000000000000000000000000000000"
boundary=""
tag_shas=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue           # a deletion pushes nothing to gate
  case "$remote_ref" in
    refs/tags/*) boundary="release"; tag_shas="$tag_shas $local_sha" ;;
    *) [ "$boundary" = "release" ] || boundary="push" ;;
  esac
done
[ -z "$boundary" ] && exit 0

# A tag publishes docs/known-issues.md as that release's disclosure, so the page must agree with
# the bug corpus there, and only there (US0898): between releases it states what the last cut
# wrote, and filing or closing a finding does not redden anything. Judged at each pushed tag's
# COMMIT, never the working tree: a page written and left uncommitted is not the page the tag
# ships. Exit 1 is a disagreement; anything else means the check could not run. Cheap, so first.
for sha in $tag_shas; do
  python3 tools/known_issues.py check --at "$sha" 1>&2
  ki_rc=$?
  if [ "$ki_rc" -eq 1 ]; then
    echo "pre-push: docs/known-issues.md disagrees with the bug corpus at tagged commit $sha - cut it with: python3 tools/known_issues.py write --release <version>, commit, and tag that commit" >&2
    exit 1
  elif [ "$ki_rc" -ne 0 ]; then
    echo "pre-push: the known-issues check could not run on tagged commit $sha (exit $ki_rc, see above) - the tag is refused until it can" >&2
    exit 1
  fi
done

# The connection has to survive the gate. Minutes of boundary lanes run before git writes a
# byte, and an ssh connection idle that long is dropped before the push starts - so the gate
# passes and the push fails, and the retry pays the gate again. Named here rather than only in
# the enabling script, because the pusher meets this line at the moment it matters.
# BEFORE the red-CI read, not after the cost line: a push refused for an unacknowledged red
# main exits inside that block, and the pusher whose connection is about to drop is exactly
# the one who then retries. The advice has to reach every boundary push, not the ones that
# get as far as paying.
echo "pre-push: the connection must stay up across the gate; set it once with: bash tools/enable-hooks.sh (ssh ServerAliveInterval)" >&2

# --- read the latest push-triggered Lint run on main BEFORE the gate (BG0642, D0181) -------
# A red main must be READ before the next push, not discovered two days later in a tab. The
# hook asks the forge for the latest COMPLETED push-triggered Lint run on main - never a
# scheduled corpus run, never Dependabot's - and refuses on any conclusion but success until
# that run's id is acknowledged, once, per clone. An unreadable or empty answer is named as
# such and never rendered as green; it does not block an offline push. Written against bash
# builtins, git, python3 and gh only, because the fixture PATH holds nothing else.
ack_file="sdlc-studio/.local/push-ack.json"
# One read: sets ci_read to UNREAD, EMPTY, or `<run id>\t<conclusion>\t<url>`.
read_ci() {
  local ci_json
  if ! ci_json="$(gh run list --workflow Lint --branch main --event push --status completed --limit 1 --json databaseId,conclusion,url 2>/dev/null)"; then
    ci_read="UNREAD"
    return
  fi
  ci_read="$(python3 - "$ci_json" <<'PY' 2>/dev/null || echo "UNREAD"
import json, sys
try:
    runs = json.loads(sys.argv[1] or "[]") or []
except ValueError:
    print("UNREAD"); raise SystemExit(0)
if not isinstance(runs, list):
    print("UNREAD"); raise SystemExit(0)      # a number or an object is not a run list
if not runs:
    print("EMPTY"); raise SystemExit(0)
r = runs[0] if isinstance(runs[0], dict) else {}
if not str(r.get("databaseId", "")).strip():
    print("UNREAD"); raise SystemExit(0)      # no id to acknowledge against: never "already acknowledged" by an empty match
print("\t".join(str(r.get(k, "")) for k in ("databaseId", "conclusion", "url")))
PY
)"
}
read_ci
# BG0709: the forge's ordering is eventually consistent, and a stale first row once named a
# two-month-old red while the newest run was green. A red answer is read ONCE more before anything
# is refused or acknowledged, and the second answer is the one judged - unless it could not be
# read, which never clears a red.
case "$ci_read" in
  UNREAD|EMPTY) ;;
  *)
    first="$ci_read"; rest="${first#*	}"
    if [ "${rest%%	*}" != "success" ]; then
      read_ci
      case "$ci_read" in
        UNREAD|EMPTY) ci_read="$first" ;;
        "$first") ;;
        *) echo "pre-push: the first answer named run ${first%%	*} (${rest%%	*}); the re-read names run ${ci_read%%	*}, and that is judged" >&2 ;;
      esac
    fi ;;
esac
case "$ci_read" in
  EMPTY)  echo "pre-push: no completed Lint run on main to read" >&2 ;;
  UNREAD) echo "pre-push: CI state UNREAD: could not read the latest Lint run on main" >&2 ;;
  *)
    run_id="${ci_read%%	*}"; rest="${ci_read#*	}"; conclusion="${rest%%	*}"; run_url="${rest#*	}"
    if [ "$conclusion" != "success" ]; then
      acked="$(python3 - "$ack_file" <<'PY' 2>/dev/null
import json, os, sys
p = sys.argv[1]
print(json.load(open(p)).get("acknowledged", "") if os.path.exists(p) else "")
PY
)"
      if [ -n "${SDLC_PUSH_ACK_RED:-}" ] && [ "$SDLC_PUSH_ACK_RED" = "$run_id" ]; then
        if python3 - "$ack_file" "$run_id" <<'PY' 2>/dev/null
import json, os, sys
p = sys.argv[1]
os.makedirs(os.path.dirname(p), exist_ok=True)
json.dump({"acknowledged": sys.argv[2]}, open(p, "w"))
PY
        then
          echo "pre-push: red Lint run $run_id acknowledged and remembered for this clone" >&2
        else
          echo "pre-push: red Lint run $run_id acknowledged but the record could not be written at $ack_file - fix the path and push again" >&2
          exit 1
        fi
      elif [ "$acked" = "$run_id" ]; then
        echo "pre-push: red Lint run $run_id already acknowledged for this clone" >&2
      else
        echo "pre-push: the latest push-triggered Lint run on main concluded $conclusion and has not been read: run $run_id ($run_url)" >&2
        echo "  read it, then acknowledge it by id: SDLC_PUSH_ACK_RED=$run_id git push" >&2
        exit 1
      fi
    fi ;;
esac

# --- announce the cost, then pay it -------------------------------------------------------
cost="$(python3 tools/gate_timing.py estimate --suite "boundary-$boundary" --warn-seconds 0 2>/dev/null || true)"
if [ -z "$cost" ]; then
  # No run recorded for this boundary yet (the first push is the one this hook exists for). A
  # measured literal: the full suite across every core is about four and a half minutes here, and
  # the tag's three lanes add about ten more.
  if [ "$boundary" = "release" ]; then
    cost="boundary-release: no run recorded yet - expect about fifteen minutes (the full suite plus release-rehearsal, revert-check and module-alone)"
  else
    cost="boundary-push: no run recorded yet - expect about five minutes (the full suite once, plus the core gate lanes)"
  fi
fi
echo "pre-push: $cost. Bypass once with: git push --no-verify" >&2
# Scrubbed exactly as the commit hooks scrub their suite lanes, and for the same reason: git
# hands a pre-push hook the pushing repository's locations, and the gate's rehearsal lane builds
# git repositories of its own - unscrubbed, every one of them is steered at this clone. The
# scrub is written out on each invocation so the list is pinned where it is used. The gate's
# stdout is sent to stderr: git shows a pusher the hook's stderr, and the refusal below says
# "see the lane named above", so the lane name has to be on the stream the refusal is on.
#
# SDLC_STUDIO_BOUNDARY_SUITE=1 on BOTH invocations, and only here: it is what makes a
# `@boundary_only` test execute rather than skip (scripts/tests/boundary.py): the full-suite lane's
# runner, and at a tag module-alone's per-module interpreters, inherit it from the gate. Without it
# the push boundary ran none of the tests deferred to it, and CI was the first thing to see one go
# red.
t0=$SECONDS
if [ "$boundary" = "release" ]; then
  /usr/bin/env -u GIT_DIR -u GIT_COMMON_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
     -u GIT_INDEX_VERSION -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
     -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES -u GIT_DISCOVERY_ACROSS_FILESYSTEM \
     -u GIT_PREFIX SDLC_STUDIO_BOUNDARY_SUITE=1 python3 "$skill/gate.py" --boundary release 1>&2
  rc=$?
else
  /usr/bin/env -u GIT_DIR -u GIT_COMMON_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
     -u GIT_INDEX_VERSION -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
     -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES -u GIT_DISCOVERY_ACROSS_FILESYSTEM \
     -u GIT_PREFIX SDLC_STUDIO_BOUNDARY_SUITE=1 python3 "$skill/gate.py" --boundary push 1>&2
  rc=$?
fi
python3 tools/gate_timing.py record --suite "boundary-$boundary" --seconds "$((SECONDS - t0))" >/dev/null 2>&1 || true
if [ "$rc" -ne 0 ]; then
  echo "pre-push: the $boundary boundary gate refused this push - see the lane named above." >&2
  echo "  re-run: SDLC_STUDIO_BOUNDARY_SUITE=1 python3 $skill/gate.py --boundary $boundary" >&2
  echo "  bypass once (emergency only): git push --no-verify" >&2
  exit "$rc"
fi
exit 0
