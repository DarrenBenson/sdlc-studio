#!/usr/bin/env bash
# SDLC Studio commit-msg gate (opt-in). Two jobs, in this order:
#
#   1. the commit-MESSAGE rules, checked in milliseconds;
#   2. the expensive unit suites, deferred here from pre-commit.
#
# The order is the point. Git invokes pre-commit BEFORE the commit message exists, so no
# arrangement of lanes inside that hook could put the message rules ahead of a 2.5-minute
# test run: a one-line subject defect was refused only after the whole gate had been paid
# for, and then paid for again on the retry. Two full suite runs for a fault knowable
# before anything executed, which is what teaches an author to reach for --no-verify. The
# suites therefore run here, behind the message check, and a refused message costs neither.
#
# 1. THE MESSAGE RULES. REFUSES a commit whose subject names more than one work-item id
# (US/BG/CR) without a `Refs: <id>` trailer per owning id. Such a shared commit is skipped
# by the engagement floor's git leg - it cannot attribute a file to one id among several -
# so an understated `Affects` would go uncaught. The refusal is cheap to satisfy: the hook
# prints the exact trailer lines to paste. The cost of enforcing is one retry; the cost of
# not enforcing is an unattributable commit the floor cannot check.
#
# It used to print that reasoning and then exit 0, letting the commit land without the
# trailer - a guard that named the hole it was leaving, and left it. Now the behaviour
# matches the words.
#
# Deliberately allowed through:
#   - a subject naming exactly ONE id (attribution is unambiguous - nothing to disambiguate)
#   - a merge, revert, cherry-pick, rebase replay, fixup!/squash!/amend! - git wrote or
#     replayed that message, the author cannot restructure it, and the work it records was
#     gated on its original commit
# Degrades honestly: with no python3, no script, or an unreadable message the check is
#   skipped and never blocks a legitimate commit.
#
# 2. THE UNIT SUITES. Run only when pre-commit selected them and left its handover record.
# Every exemption above releases the MESSAGE check alone - a conflicted merge resolved by
# hand still runs pre-commit, so it still pays for the suites exactly as it did before, and
# a plain `git merge` (which runs this hook but not pre-commit) still pays for nothing.
#
# Opt-in: both jobs run only in a clone that has enabled the tracked hooks
#   (bash tools/enable-hooks.sh -> core.hooksPath=.githooks). Never forced on a consuming
#   project.
# The one escape is the repo's usual one: git commit --no-verify. There is no second bypass.
# Its lanes:  .githooks/commit-msg --list
set -uo pipefail

# --list prints one line per lane, `<key><TAB><rule>`, and runs nothing. It reads this file's own
# `run` calls, so a lane added below is listed with no other file edited. The same reader as
# pre-commit's: each hook is copied and run on its own, so neither can source the other.
if [ "${1:-}" = "--list" ]; then
  awk -f - "${BASH_SOURCE[0]}" <<'AWK'
want { if (match($0, /"[^"]*"/)) print key "\t" substr($0, RSTART + 1, RLENGTH - 2); want = 0; next }
/^[[:space:]]*run "[^"]+"/ {
  rest = $0; sub(/^[[:space:]]*run "/, "", rest)
  key = rest; sub(/".*/, "", key); rest = substr(rest, length(key) + 2)
  if (match(rest, /"[^"]*"/)) print key "\t" substr(rest, RSTART + 1, RLENGTH - 2); else want = 1
}
AWK
  exit 0
fi

msg_file="${1:-}"
# Absolute before anything changes directory. Git runs hooks from the top of the working
# tree and may hand over a path relative to it, and this hook now cds to the repo root so
# the suite lanes below resolve `tools/...` the same way pre-commit does.
case "$msg_file" in "" | /*) ;; *) msg_file="$PWD/$msg_file" ;; esac

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null)" || exit 0
cd "$repo_root" || exit 0
skill=".claude/skills/sdlc-studio/scripts"
script="$repo_root/$skill/engagement_floor.py"
# The repo-writes snapshot pre-commit took: checked by the lane below, dropped on a refusal.
writes_snapshot="$(git rev-parse --git-path sdlc-repo-writes 2>/dev/null || true)"
[ -n "$writes_snapshot" ] || writes_snapshot="$git_dir/sdlc-repo-writes"

# Colour only when writing to a terminal.
if [ -t 1 ]; then R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; B=$'\033[1m'; N=$'\033[0m'; else R=; G=; Y=; B=; N=; fi

fail=0

# run KEY  "what it enforces"  "how to fix"  -- command...
# Every refusal in this hook goes through here, the message rule first, so `--list` names them all.
run() {
  local key="$1" what="$2" fixhint="$3"; shift 3
  [ "$1" = "--" ] && shift
  local out
  # Stashed for the caller on BOTH paths: the budget lane needs to know how many tests
  # actually ran, which is only knowable from the output of a run that passed as well as
  # one that failed.
  if out="$("$@" 2>&1)"; then
    last_run_out="$out"
    printf '  %sok%s   %s\n' "$G" "$N" "$key"
    return 0
  fi
  last_run_out="$out"
  fail=1
  refused+=("$key")
  printf '  %sFAIL%s %s%s%s\n' "$R" "$N" "$B" "$key" "$N"
  printf '       enforces: %s\n' "$what"
  if [ -n "$out" ]; then
    printf '       %s─ details ─%s\n' "$Y" "$N"
    printf '%s\n' "$out" | sed 's/^/         /'
  fi
  printf '       %s→ fix:%s %s\n\n' "$B" "$N" "$fixhint"
}

# THE REFUSAL LOG. Each refusing lane is recorded as one JSON line - the lane, a UTC timestamp
# and the staged paths with their blob ids - in gitignored sdlc-studio/.local/refusals.jsonl, and the close joins each
# line to the commit that followed it: code or a test changed from what was refused there is a
# candidate catch, anything else is paperwork. `run` only NOTES the lane; the line is written where the hook
# closes on its refusal exit, after the repo-writes window has shut, so the log can never read as
# a stray write into `.local/`. Best effort: it never refuses and never changes an exit code. The
# same block is in the other hook, which cannot source this one.
refused=()
log_refusals() {
  [ "${#refused[@]}" -gt 0 ] || return 0
  mkdir -p sdlc-studio/.local 2>/dev/null
  python3 -c '
import json, subprocess, sys, time
ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
out = subprocess.run(["git", "diff", "--cached", "--raw", "-z", "--no-abbrev", "--no-renames"],
                     capture_output=True, text=True).stdout.split("\0")
blobs = {path: meta.split()[3] for meta, path in zip(out[0::2], out[1::2]) if meta[:1] == ":"}
with open("sdlc-studio/.local/refusals.jsonl", "a", encoding="utf-8") as log:
    for lane in sys.argv[1:]:
        log.write(json.dumps({"lane": lane, "ts": ts, "staged": list(blobs),
                              "blobs": blobs}) + "\n")
' "${refused[@]}" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# 1. The commit-message rules.
# ---------------------------------------------------------------------------
check_message=1
{ [ -n "$msg_file" ] && [ -r "$msg_file" ]; } || check_message=0
command -v python3 >/dev/null 2>&1 || check_message=0
[ -f "$script" ] || check_message=0

# A machine-written or replayed message: git is mid-merge / mid-revert / mid-cherry-pick /
# mid-rebase. Refusing here would break `git merge` and `git revert` on a subject that
# happens to name several ids, and nobody could satisfy the refusal anyway.
for marker in MERGE_HEAD REVERT_HEAD CHERRY_PICK_HEAD rebase-merge rebase-apply; do
  [ -e "$git_dir/$marker" ] && check_message=0
done

if [ "$check_message" -eq 1 ]; then
  # The subject: the first line that is neither blank nor git scaffolding (`#`).
  subject="$(grep -m1 -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$msg_file" || true)"
  case "$subject" in
    # Same reasoning as the markers above, for the cases that carry no marker: a merge or
    # revert message git generated, and an autosquash instruction whose final message is
    # the target commit's (which was itself gated).
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) check_message=0 ;;
  esac
fi

# The decision is the script's (single source of the id grammar). --strict makes it exit
# non-zero on a finding; a parse/read failure inside it still exits 0, so a message the
# script cannot understand never blocks. A pass prints only the attribution advisory, which
# reaches the block below through `last_run_out`.
message_lane() {
  local out
  if out="$(python3 "$script" check-commit-msg --strict "$msg_file" 2>&1)"; then
    printf '%s' "$out"
    return 0
  fi
  # Paste-ready trailers for the ids the subject names but no `Refs:` line covers. Ids are
  # normalised (CR-0257 -> CR0257) on both sides so a dashed spelling does not read as a gap.
  # The SAME grammar the engagement floor reads: the v2 four-or-more digit form AND the v3
  # `-<short ULID>` form, matched case-sensitively so it stops at the lowercase `-slug`. A
  # four-digit-only pattern printed a WRONG id for a ULID unit - `BG-01JQK3F8` became `BG01JQ`
  # - which is a paste-ready hint that produces a trailer naming a different artefact.
  ids() { grep -oE '(EP|US|PL|BG|TS|WF|RFC|CR|IS)(-[0-9A-HJKMNP-TV-Z]{8,}|-?[0-9]{4,})' \
            | sed -E 's/^([A-Z]+)-([0-9]+)$/\1\2/' | sort -u; }
  named="$(printf '%s\n' "$subject" | ids)"
  covered="$(grep -iE '^[[:space:]]*Refs:' "$msg_file" | ids)"
  uncovered="$(comm -23 <(printf '%s\n' "$named") <(printf '%s\n' "$covered"))"
  printf '%s\n' "$out" | grep -v 'blocked by strict mode'
  printf 'add these lines to the message body (after a blank line):\n\n'
  if [ -n "$uncovered" ]; then
    printf '%s\n' "$uncovered" | sed 's/^/  Refs: /'
  else
    printf '  Refs: <id>   # one line per id the subject names\n'
  fi
  return 1
}

msg_out=""
if [ "$check_message" -eq 1 ]; then
  run "message-refs" \
    "a subject naming two or more work-item ids carries a Refs: <id> trailer per owning id, so the engagement floor can attribute the commit's files per id (a shared commit with no trailer is skipped, and an understated Affects then goes uncaught)" \
    "add the Refs: lines printed above to the message body, then commit again; a subject naming a single id needs no trailer" \
    -- message_lane
  msg_out="$last_run_out"
fi

# The message lane refuses BEFORE the suites: a message defect costs seconds, not a full gate.
if [ "$fail" -ne 0 ]; then
  printf '  The unit suites did NOT run: this refusal cost seconds, not a full gate.\n'
  printf '  Genuine emergency only: %sgit commit --no-verify%s\n' "$B" "$N"
  # The suite handover is left where it is: the retry runs pre-commit again, which rewrites it
  # from the index as it stands then. The repo-writes snapshot goes - no suite runs between it
  # and a check now, and the retry takes a fresh one - so the refusal log below is written
  # with no comparison window open.
  rm -f "$writes_snapshot" 2>/dev/null
  log_refusals
  exit 1
fi

# The attribution advisory. A commit whose staged files fall under the `Affects` of a unit the
# message never names is the shape of a mis-attribution - a `git add -A` sweeping in the unit
# being written while the previous one's commit runs, which this project does constantly. The
# script prints it and exits 0; it is REPORTED here rather than refused, because ownership is
# inferred from a declaration and a gate that blocked on an inference gets switched off. A
# passing message otherwise prints nothing, so anything left in msg_out IS the advisory.
if [ "${msg_out:-}" != "" ]; then
  {
    printf '  %sattribution note%s (advisory - the commit is not blocked)\n' "$Y" "$N"
    printf '%s\n' "$msg_out" | sed 's/^/    /'
  } >&2
fi

# ---------------------------------------------------------------------------
# 2. The unit suites, if pre-commit selected them.
# ---------------------------------------------------------------------------
# NO MESSAGE, NO COMMIT TO GATE. An invocation that was handed no readable message file has
# nothing to check and nothing to gate, so running the lanes for it is work nobody asked for.
# The condition is the ABSENT MESSAGE and never the identity of the caller: a probe for a test
# variable is a second bypass, and it would not even work - this repo's own hook fixtures build
# their environment as `{**os.environ}` minus three GIT_* keys, so `PYTEST_CURRENT_TEST` is set
# inside every one of them and such a probe would fire for real commits made from a test too.
#
# BG0595: `test_no_argument_does_not_block` passed neither `cwd` nor a scrubbed env, so it ran
# this hook against the developer's own repository, consumed the `sdlc-gate-suites` record a
# real commit was going to use, and started a full skill suite inside a unit test - 1.84s
# became minutes. The record is left in place on a REFUSED message deliberately (the retry
# rewrites it), so the fix is not to delete it; it is to not come looking when there is no
# message to gate.
{ [ -n "$msg_file" ] && [ -r "$msg_file" ]; } || exit 0

# The handover record, and the only thing that selects these lanes. Deliberately NOT an
# exported environment latch: the tool-tests lane below runs this repo's own hook tests,
# whose fixtures make real commits in their own throwaway repos, and a latch would be
# inherited by every one of them - measured, and it silently reduced each fixture commit
# to its cheap half. The record is per git directory instead, so a fixture repo's gate is
# selected by its own pre-commit and this run cannot suppress it.
handoff="$(git rev-parse --git-path sdlc-gate-suites 2>/dev/null || true)"
[ -n "$handoff" ] || handoff="$git_dir/sdlc-gate-suites"
[ -r "$handoff" ] || exit 0
precommit_seconds="$(sed -n 's/^precommit_seconds=\([0-9][0-9]*\)$/\1/p' "$handoff" | tail -1)"
# The SELECTION, read here beside the seconds rather than 40 lines below - where the file had
# already been deleted. `selectors` was therefore always empty, every run recorded
# `verdict-mode full`, and `total.tests` read the whole suite on every commit in the recorded
# history. Several hundred lines of selection logic ran, produced an answer, and the answer
# was thrown away; the suites are 86% of the gate, so this one ordering paid for it.
#
# Absent still means run everything: a missing list is an unanswered question, never an
# answer of "nothing to run".
selectors="$(sed -n 's/^suite-selector=//p' "$handoff" 2>/dev/null | tr '\n' ' ')"
# One-shot: read once, then gone. A record that outlived its commit would charge the next
# commit-msg-only operation for a suite run nobody asked for. Deleted AFTER both reads.
rm -f "$handoff" 2>/dev/null
command -v python3 >/dev/null 2>&1 || exit 0

# The repo-locating variables every suite lane clears, for the reason tools/skill-tests.sh gives:
# a hook invoked by `git commit -a` is handed GIT_INDEX_FILE pointing at the OUTER repo's index,
# and any test that shells out to git would then write THIS repo's pending commit instead of its
# own fixture's. One list for every lane here, so the lanes cannot drift apart.
scrub=(/usr/bin/env -u GIT_DIR -u GIT_COMMON_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE
       -u GIT_INDEX_VERSION -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES
       -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES -u GIT_DISCOVERY_ACROSS_FILESYSTEM
       -u GIT_PREFIX)

ran_pytest=0
if [ -n "$selectors" ] && python3 -c 'import pytest' >/dev/null 2>&1; then
  # THE SELECTED RUN: one pytest invocation over both trees, across every core when pytest-xdist
  # is installed, with the `serial_only` tests after (`gate.py --run-tests`). pytest captures a
  # passing test's output, so the green-run noise ratchet in tools/skill-tests.sh is held where
  # the whole suite runs under it: in CI.
  ran_pytest=1
  run "unit-tests" \
    "every selected test module passes (in parallel when pytest-xdist is installed)" \
    "fix the code or the test named above; re-run: python3 $skill/gate.py --run-tests <module>" \
    -- "${scrub[@]}" python3 "$skill/gate.py" --root . --run-tests $selectors
  [ "$fail" -eq 0 ] && printf '%s\n' "$last_run_out" | grep '^unit-tests:' | sed 's/^/       /'
  if [ "$fail" -ne 0 ]; then
    mkdir -p sdlc-studio/.local 2>/dev/null
    printf '%s\n' "$last_run_out" > sdlc-studio/.local/gate-suite-last.log 2>/dev/null || true
    printf '  %ssuite output saved to sdlc-studio/.local/gate-suite-last.log%s\n' "$Y" "$N" >&2
  fi
else
  # One run of the suite, held to two standards: every test passes, AND a passing run is
  # silent (an expected diagnostic from a bad-fixture test must be captured and asserted on,
  # not leaked to the console, or a real error hides in the noise). Both read the same run -
  # a guard paid for on every commit has to be cheap, or it gets disabled and guards nothing.
  # Split the selection by suite: each runner is handed only the modules under its own tree,
  # because `tools/tests` and the skill tests are discovered from different roots and a path
  # from one means nothing to the other.
  skill_sel=""; tool_sel=""
  for s in $selectors; do
    case "$s" in
      tools/tests/*) tool_sel="$tool_sel $s" ;;
      *) skill_sel="$skill_sel $s" ;;
    esac
  done
  if [ -n "$selectors" ]; then
    printf '  %snote%s running %s selected test module(s) (the whole suite runs at push, release and close)\n' \
      "$Y" "$N" "$(printf '%s\n' "$selectors" | wc -w)"
  fi

  t0=$SECONDS
  run "skill-tests" \
    "every shipped skill script unit test passes, and a green run prints no stray diagnostics" \
    "fix the code or the test named above; re-run: bash tools/skill-tests.sh" \
    -- bash tools/skill-tests.sh "$skill" $skill_sel
  python3 tools/gate_timing.py record --suite skill-tests --seconds "$((SECONDS - t0))" 2>/dev/null
  # The failure has to SURVIVE the retry. The lane prints into the hook's own output, so by the
  # time a retry succeeded the evidence of what failed was gone - twice, and neither failing test
  # was ever identified. A blocked commit now leaves the output behind to be read.
  #
  # Captured HERE, per lane, rather than once below both: `last_run_out` holds only the most
  # recent lane's output, so a single capture after the second lane would overwrite a failing
  # skill lane's evidence with the passing tool lane's. The first lane to fail owns the log.
  if [ "$fail" -ne 0 ]; then
    mkdir -p sdlc-studio/.local 2>/dev/null
    printf '%s\n' "$last_run_out" > sdlc-studio/.local/gate-suite-last.log 2>/dev/null || true
    printf '  %ssuite output saved to sdlc-studio/.local/gate-suite-last.log%s\n' "$Y" "$N" >&2
  fi
  skill_fail=$fail
  suite_tests=$(printf '%s\n' "$last_run_out" | sed -n 's/^Ran \([0-9]*\) tests\{0,1\} in .*/\1/p' | tail -1)
  printf '%s\n' "$last_run_out" | grep -q '_FailedTest' && loader_error=1
  t0=$SECONDS
  # Scrubbed through `scrub` above, as tools/skill-tests.sh scrubs its own suite.
  # Same selection contract as the skill lane: dotted module names on PYTHONPATH when the gate
  # resolved a subset, plain discovery when it did not. `unittest` refuses a file path, and
  # running from inside tools/tests would move the cwd these fixtures resolve against.
  if [ -n "$tool_sel" ]; then
    tool_mods=""
    for f in $tool_sel; do
      base="${f##*/}"
      tool_mods="$tool_mods ${base%.py}"
    done
    set -- python3 -m unittest $tool_mods
  else
    set -- python3 -m unittest discover -s tools/tests
  fi
  run "tool-tests" \
    "every repo-only tools/ checker unit test passes" \
    "fix the code or the test named in the failure above; re-run: python3 -m unittest discover -s tools/tests" \
    -- "${scrub[@]}" "PYTHONPATH=tools/tests${PYTHONPATH:+:$PYTHONPATH}" "$@"
  python3 tools/gate_timing.py record --suite tool-tests --seconds "$((SECONDS - t0))" 2>/dev/null
  # The tool lane is a suite lane too, so a failure here also has to survive the retry. Only when
  # the skill lane passed - otherwise its log is already on disk and is the one worth keeping.
  if [ "$fail" -ne 0 ] && [ "${skill_fail:-0}" -eq 0 ]; then
    mkdir -p sdlc-studio/.local 2>/dev/null
    printf '%s\n' "$last_run_out" > sdlc-studio/.local/gate-suite-last.log 2>/dev/null || true
    printf '  %ssuite output saved to sdlc-studio/.local/gate-suite-last.log%s\n' "$Y" "$N" >&2
  fi
  tool_tests=$(printf '%s\n' "$last_run_out" | sed -n 's/^Ran \([0-9]*\) tests\{0,1\} in .*/\1/p' | tail -1)
  printf '%s\n' "$last_run_out" | grep -q '_FailedTest' && loader_error=1
  # Both lanes together are what a code commit pays for, so the scope check reads their sum.
  suite_tests=$(( ${suite_tests:-0} + ${tool_tests:-0} ))
fi

# THE AFTER HALF OF THE REPO-WRITES LANE. `pre-commit` recorded the working tree at the moment
# it selected the suites; this compares it against the tree the suites have just left behind and
# refuses on any difference, naming every path.
#
# The invariant broke four times in two days - a fixture helper handed `.` as its root, a
# rehearsal harness whose work root was the repository, a batch verb run without --dry-run, and
# a stray artefact from a fixture - and every one was found by an unrelated gate rather than by
# its author. One destroyed 23 mutation registrations in gitignored `sdlc-studio/.local/`, which
# nothing could restore.
#
# Placed HERE, below `tool_tests` and the log-saving block, because those read `last_run_out`
# and `run` overwrites it: a lane inserted above them would silently replace a failing suite's
# evidence with this lane's output. And above the verdict record below, which is the last thing
# a passing hook does - anything that can still set `fail` belongs before it.
#
# The record (`writes_snapshot`, set at the top) is one-shot, like the handover: read once, then
# gone.
if [ -r "$writes_snapshot" ]; then
  run "repo-writes" \
    "running the unit suites leaves the working tree unchanged: no tracked file modified, no untracked file created, nothing written into gitignored sdlc-studio/.local/" \
    "find the root the fixture took - a helper that accepts a root and was handed \`.\`, a work root not under tempfile, or a batch verb missing --dry-run - then restore the paths named above (a .local/ path cannot be restored, so check what it held)" \
    -- python3 tools/repo_writes.py check --root . --since "$writes_snapshot"
  rm -f "$writes_snapshot" 2>/dev/null
fi

# THE COLLAPSE CHECK, on the unittest path only - the one whose output carries a test count. A
# suite that has stopped running most of itself commits green, because a deleted test cannot
# fail; this lane blocks that (BG0413). It reads the test COUNT and whether a module failed to
# load, never the duration. A selected run is not held to the full-suite peak.
total_seconds=$(( ${precommit_seconds:-0} + SECONDS ))
total_suite="$([ -n "$selectors" ] && echo total.selected || echo total)"
scope_rc=0
if [ "$ran_pytest" -eq 0 ]; then
  scope_args="--suite total --tests ${suite_tests:-0}"
  [ "${loader_error:-0}" -eq 1 ] && scope_args="$scope_args --loader-error"
  [ -n "$selectors" ] && scope_args="$scope_args --selected"
  # shellcheck disable=SC2086
  scope_note="$(python3 tools/gate_timing.py scope $scope_args 2>/dev/null)"
  scope_rc=$?
  # Refuses on THREE and a non-empty note only: python exits 2 for an argparse error or a
  # missing script, and a verdict this lane blocks on must be able to say why.
  scope_lane() { printf '%s\n' "$scope_note"; [ "$scope_rc" -ne 3 ] || [ -z "$scope_note" ]; }
  run "suite-collapse" \
    "a unittest run is not a collapsed suite: its test count is not far below what the surface demands" \
    "find why the suite stopped running most of itself - a deleted, renamed or unloadable test module - and restore it; the note above gives the count against the floor" \
    -- scope_lane
  # Any other note is advisory: printed, never refused.
  if [ "$scope_rc" -ne 0 ] && [ "$scope_rc" -ne 3 ] && [ -n "$scope_note" ]; then
    printf '  %s%s%s\n' "$Y" "$scope_note" "$N"
  fi
fi
# The planner prices a commit from this series (sprint.py reads it), so the elapsed time is kept.
[ "$scope_rc" -eq 0 ] &&
  python3 tools/gate_timing.py record --suite "$total_suite" --seconds "$total_seconds" 2>/dev/null

# THE BUDGET: the commit's elapsed time, this hook plus pre-commit's share, against 90 seconds.
# Reported on every run that reached the suites, and NEVER a refusal: a wall-clock limit on a
# loaded or shared machine must not block a correct commit. Over it, the line says so and names
# where the rest of the coverage is paid.
commit_budget=90
if [ "$total_seconds" -gt "$commit_budget" ]; then
  printf '  %sover budget%s this commit took %ss against a %ss budget - reported, not refused.\n' \
    "$Y" "$N" "$total_seconds" "$commit_budget"
  printf '       A wide selection means the change reaches a large test module; the full suite runs at push.\n'
else
  printf '  %sbudget%s this commit took %ss of its %ss budget.\n' "$G" "$N" "$total_seconds" "$commit_budget"
fi

# Record the green so a later commit over an unchanged surface can reuse it. Without this call
# no verdict is ever written, read_suite_verdict is always None, and the skip branch is
# unreachable in production however well it is tested.
#
# ONLY when BOTH lanes passed, and therefore only HERE - BELOW EVERYTHING THAT CAN STILL SET
# `fail`. This ran unconditionally once, so a FAILING skill lane still wrote `status green`;
# moving it under `$fail` fixed that half but left it BETWEEN the lanes, where `fail` carried
# only the skill lane's verdict, so a green skill lane beside a failing tool lane wrote green
# just the same. That was BG0489. It then sat ABOVE the scope check, which is the third door
# (BG0507): a suite that had COLLAPSED - far fewer tests run than the surface demands - blocked
# the commit on `scope_rc` 3 and still left `status green` at that HEAD, and because pre-commit
# skips the suites when a current green verdict covers the surface, the byte-identical retry
# landed the collapsed suite.
#
# The rule that closes all three, and the one to keep: the verdict is the LAST thing a passing
# hook does. Anything that can still set `fail` belongs above this block. Placement is the
# guard here as much as the condition is, which is why it is pinned by executing the hook
# rather than by reading its source - a source-order grep was green on two of these shapes.
if [ "$fail" -eq 0 ]; then
  python3 "$skill/gate.py" --root . --record-suite-verdict "$(git rev-parse HEAD 2>/dev/null || echo pending)" \
    --status green --verdict-mode "$([ -n "$selectors" ] && echo selected || echo full)" 2>/dev/null || true
fi

if [ "$fail" -ne 0 ]; then
  printf '\n%sCommit blocked.%s Fix the failures above (each lists how), then commit again.\n' "$R" "$N"
  printf 'Genuine emergency only: %sgit commit --no-verify%s\n' "$B" "$N"
  log_refusals   # below the repo-writes check, which has already consumed its snapshot
  exit 1
fi
printf '%sgate green.%s\n' "$G" "$N"
exit 0
