#!/usr/bin/env bash
# SDLC Studio pre-commit gate.
#
# Runs the repo's npm-independent guards so style, neutrality, line-budget,
# version, link, and index-drift breakage cannot reach a commit. Every failure
# is explained in detail: what the guard enforces, the full violation output,
# and how to fix it (self-diagnosing findings, per CR0132).
#
# Enable once per clone:  bash tools/enable-hooks.sh   (sets core.hooksPath)
# Bypass (emergencies only):  git commit --no-verify
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "pre-commit: not a git repo"; exit 1; }
cd "$repo_root" || exit 1
skill=".claude/skills/sdlc-studio/scripts"
fail=0

# Colour only when writing to a terminal.
if [ -t 1 ]; then R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; B=$'\033[1m'; N=$'\033[0m'; else R=; G=; Y=; B=; N=; fi

# run KEY  "what it enforces"  "how to fix"  -- command...
run() {
  local key="$1" what="$2" fixhint="$3"; shift 3
  [ "$1" = "--" ] && shift
  local out
  # Stashed for the caller on BOTH paths. A green run's output used to be discarded, but the
  # budget lane needs to know how many tests actually ran, and that is only knowable from the
  # output of a run that passed as well as one that failed (BG0239).
  if out="$("$@" 2>&1)"; then
    last_run_out="$out"
    printf '  %sok%s   %s\n' "$G" "$N" "$key"
    return 0
  fi
  last_run_out="$out"
  fail=1
  printf '  %sFAIL%s %s%s%s\n' "$R" "$N" "$B" "$key" "$N"
  printf '       enforces: %s\n' "$what"
  if [ -n "$out" ]; then
    printf '       %s─ details ─%s\n' "$Y" "$N"
    printf '%s\n' "$out" | sed 's/^/         /'
  fi
  printf '       %s→ fix:%s %s\n\n' "$B" "$N" "$fixhint"
}

echo "${B}sdlc-studio pre-commit gate${N}"

# The concurrent-write window guard is the gate's `window` lane, run by `gate.py --root .` below:
# ONE implementation. An inline copy used to run here first, duplicating the lane's reader and
# matcher, and the two drifted apart more than once.

run "style" \
  "house style: no em-dash (U+2014); no jargon (synergy/leverage/robust/journey); no internal provenance tags (CR1234) in reference/help/scripts" \
  "reword the flagged line; a legitimate case can be allowlisted in tools/style-allowlist.txt" \
  -- bash tools/lint-style.sh

run "links" \
  "every markdown anchor link (#heading) resolves to a real heading" \
  "correct the #anchor, or add/rename the target heading it points at" \
  -- python3 tools/check_links.py

run "skill-spec" \
  "SKILL.md frontmatter conforms to the Agent Skills spec subset" \
  "align the frontmatter fields flagged above with the spec" \
  -- python3 tools/validate_skill.py

run "versions" \
  "the version string is consistent across the authoritative files" \
  "sync the version in each file named above (or bump them together)" \
  -- python3 tools/check_versions.py

run "verify-ratchet" \
  "no NEW duplicate-verifier group: two ACs sharing a selector cannot both discriminate" \
  "split the selector so each criterion discriminates, or record the group with a reason in sdlc-studio/.verify-lint-baseline.json - the tolerated set may only shrink" \
  -- python3 .claude/skills/sdlc-studio/scripts/verify_ac.py lint --ratchet --bugs

run "stamps-staged" \
  "a staged test rename or deletion does not orphan a stamped Verify selector" \
  "repoint the selector named above at the renamed node, or restore the test - the write-time guard cannot see a rename, and the scheduled corpus lane that can was red three weeks unread (BG0653)" \
  -- python3 "$skill/verify_ac.py" stamps --staged

# A fragment is written by the same commit as the code, so this is the moment its author is still
# here to fix it. Nothing else opens one until the release cut, where compose refuses the WHOLE
# fold on the first bad fragment: 59 of 119 had drifted past it, every one through a green gate.
# Top-level and above the suite selection, so a docs-only commit carrying a fragment is judged too.
run "changelog-shape" \
  "every changelog.d/ fragment this commit stages parses the way the release cut's compose reads it: first line '<!-- section: <name> -->', a known section, entry text below it" \
  "rewrite each fragment named above - first line '<!-- section: Added|Changed|Fixed -->', the entry below it - and stage it again; the staged bytes are what is judged, not the working tree" \
  -- python3 "$skill/changelog.py" shape --staged

run "budgets" \
  "each reference-*.md stays under its declared line ceiling (keeps load cost bounded)" \
  "shrink the file, or raise its ceiling in tools/check_budgets.py deliberately (with a rationale comment)" \
  -- python3 tools/check_budgets.py

run "neutrality" \
  "no private consuming-project name leaks into a tracked file (the skill repo is domain-neutral)" \
  "generalise the name (e.g. to 'a consuming project'); the checker redacts the term, so grep your diff for it" \
  -- python3 tools/check_neutrality.py

run "dead-flags" \
  "no flag whose parsed destination NO line acts on - a documented switch that does nothing" \
  "consume the value where it lands, or delete the flag and its documentation; a destination the lane cannot judge is printed with the reason it could not (~6s, AST only, no subprocesses)" \
  -- python3 "$skill/command_audit.py" --dead-flags --root .

run "action-pins" \
  "every GitHub Action is pinned to a full commit SHA (a moved tag cannot inject code into CI)" \
  "pin the flagged Action to its tag's commit SHA: uses: owner/repo@<40-hex> # vN" \
  -- bash tools/check_action_pins.sh

# The engagement floor over the PENDING commit. The standing floor lane inside the gate
# below reads committed history, so it could never see a violation the commit it is gating
# was about to create: the condition does not exist until the commit lands. Observed - the
# floor reported 0 violations, the gate passed, the commit landed, and the same check run
# seconds later reported 2 NEW violations in files nothing had touched.
run "floor-pending" \
  "the engagement floor over the STAGED index: a unit THIS commit puts below the floor (multi-file, no acceptance criterion, no declared footprint) is refused now rather than discovered one commit later. It reads the index, NOT the commit message - git writes the message after this hook runs - so a unit named only in the message is still judged next commit" \
  "plan the unit (one acceptance criterion, a Verify line, or a linked plan), or declare a real single-file footprint in its Affects field; the lane prints the per-unit remedies" \
  -- python3 "$skill/engagement_floor.py" check --pending --root .

# Comprehensive artefact gate: conformance, reconcile drift, validate, integrity,
# duplicate-id, doc-coverage, doc-freshness. This is the same gate CI runs.
#
# COST, measured, not guessed. This comment used to sell the gate as a one-second check.
# Measured cold in fresh processes on this repo it was 32.9s - wrong by a factor of
# thirty-three, and the largest lane in the whole hook was the one an operator had been
# told to ignore. It is ~25s warm today against a declared 45s budget. Two changes landed
# together: the constitution lane lost the Done-only conformance sweep no declared
# principle read (-22s), and the reconcile lane stopped counting two of the nine drift
# sources and now reads the same sweep `reconcile detect` does (+20s, and the correctness
# it buys is that the two can no longer disagree about one tree). Most of what remains is
# reconcile's own corpus re-reads. The gate prints its own `gate cost:` line and its
# dominant lane on every run, so read that line rather than this comment for the number.
if gate_out="$(python3 "$skill/gate.py" --root . 2>&1)"; then
  printf '  %sok%s   gate (conformance / reconcile / validate / integrity / duplicate-id / docs)\n' "$G" "$N"
else
  fail=1
  printf '  %sFAIL%s %sgate%s (conformance / reconcile / validate / integrity / duplicate-id / docs)\n' "$R" "$N" "$B" "$N"
  printf '       %s─ checks ─%s\n' "$Y" "$N"
  printf '%s\n' "$gate_out" | grep -E '\[(FAIL|warn)\]|^gate:' | sed 's/^/         /'
  # Reconcile drift is the common case: list each item with its own fix (self-diagnosing).
  DRIFT_JSON="$(python3 "$skill/reconcile.py" detect --format json 2>/dev/null)"
  drift_report="$(DRIFT_JSON="$DRIFT_JSON" python3 -c '
import os, json
try:
    d = json.loads(os.environ.get("DRIFT_JSON", ""))
except Exception:
    d = {}
for t, info in d.get("types", {}).items():
    for x in info.get("drift", []):
        print("%s %s: %s -> %s" % (t, x.get("id") or "(summary)", x.get("kind"), x.get("fix", "no fix hint")))
')"
  if [ -n "$drift_report" ]; then
    printf '       %s─ drift detail ─%s\n' "$Y" "$N"
    printf '%s\n' "$drift_report" | sed 's/^/         /'
  fi
  printf '       %s→ fix:%s address each failing check; run the named script for per-item detail (e.g. `%s/validate.py check`, `%s/conformance.py`); mechanical drift clears with `%s/reconcile.py apply`\n\n' "$B" "$N" "$skill" "$skill" "$skill"
fi

# Markdown mechanics (markdownlint-cli, a devDependency). Prefer the npm-local
# binary so `npm install` is enough - no global install needed. If Node is absent
# entirely, say so loudly: it is the one guard CI enforces that cannot run here.
md_cmd=""
if [ -x node_modules/.bin/markdownlint ]; then
  md_cmd="node_modules/.bin/markdownlint"
elif command -v markdownlint >/dev/null 2>&1; then
  md_cmd="markdownlint"
fi
# WHAT GETS LINTED IS DERIVED FROM THE INDEX, NOT FROM A GLOB.
#
# These lanes used to name `**/*.md` plus one hand-added dot-directory (`.claude/**/*.md`).
# markdownlint's glob cannot enter a dot-directory at all, so the enumeration was a list of
# the dot-directories somebody remembered - and it silently exempted the ones it forgot:
# three tracked files under `.github/` (the PR template and two issue templates) matched
# neither glob here nor in `npm run lint:md`, so a markdown defect in them passed every
# per-commit and per-push lane. Only the schedule-only corpus job ever saw them, which also
# made the Node-absent SKIP message below untrue for exactly those files.
#
# `git ls-files` answers instead. It reads the INDEX, so a newly staged file is covered on
# the commit that adds it and an unstaged scratch file is not linted at all; every tracked
# dot-directory is covered without anybody having to think of it.
#
# >>> md-enumeration (executed verbatim by tools/tests/test_precommit_markdown_scope.py)
md_root=(); md_payload=()
while IFS= read -r -d '' f; do
  case "$f" in
    # Transient agent worktrees (parallel-delivery scratch): never shipped payload, and a
    # builder's half-written markdown must not block an unrelated commit in the main tree.
    .claude/worktrees/*) continue ;;
    # The shipped payload has its own config (template/example rules relaxed, mechanics
    # enforced), so it is linted as its own lane rather than under the root rule set.
    .claude/*) md_payload+=("$f") ;;
    *) md_root+=("$f") ;;
  esac
done < <(git ls-files -z -- '*.md')
# <<< md-enumeration

if [ -n "$md_cmd" ]; then
  if [ "${#md_root[@]}" -gt 0 ]; then
    run "markdown" \
      "markdown mechanics: blank lines around lists (MD032), heading levels, fenced blocks" \
      "auto-fix most with: npm run lint:fix" \
      -- $md_cmd "${md_root[@]}"
  else
    printf '  %sSKIP%s markdown - no tracked markdown outside the payload.\n' "$Y" "$N"
  fi
  if [ "${#md_payload[@]}" -gt 0 ]; then
    run "markdown-payload" \
      "markdown mechanics of the SHIPPED skill payload (.claude/), under its own config" \
      "auto-fix most with: npm run lint:fix" \
      -- $md_cmd --config .claude/skills/sdlc-studio/.markdownlint.json "${md_payload[@]}"
  else
    printf '  %sSKIP%s markdown-payload - no tracked markdown under .claude/.\n' "$Y" "$N"
  fi
else
  printf '  %sSKIP%s markdown - markdownlint not found. Run %snpm install%s to enable it locally.\n' "$Y" "$N" "$B" "$N"
  printf '       CI enforces most of it, so a markdown-mechanics error can pass here and fail on push -\n'
  printf '       but not all: `npm run lint:md` still globs, so it cannot see tracked dot-directory\n'
  printf '       markdown (.github/) that the lanes above do. For those files this SKIP is total.\n'
fi

# Unit tests: the commit runs the test modules its staged change reaches, and none when it
# reaches none - a docs or artefact commit, or code no test module imports, loads or is named
# for. `gate.py --suite-decision --staged` answers with a `suite-decision: run|skip` sentinel and
# one `suite-selector:` line per module. What it misses, the full suite at push catches.
#
# The suites RUN in the commit-msg hook, not here. Git invokes pre-commit before the commit
# message exists, so only commit-msg can refuse a message defect before the suites are paid
# for. This hook decides what is SELECTED and hands it over in a one-shot record in the git
# directory - per worktree, never in the working tree, because a gate that dirties the tree it
# is gating trains people to stage past it. The record is written or removed on EVERY path
# through this block, and commit-msg removes it before running.
#
# A skip is NAMED, never silent: a guard that quietly does not run is indistinguishable from one
# that ran and passed.
handoff="$(git rev-parse --git-path sdlc-gate-suites 2>/dev/null || true)"
[ -n "$handoff" ] || handoff="$(git rev-parse --git-dir 2>/dev/null)/sdlc-gate-suites"
rm -f "$handoff" 2>/dev/null
# The BEFORE half of the repo-writes lane, and it lives in the same git directory and under the
# same one-shot rule as the handover above, for the same reason: a gate that dirties the tree it
# is gating trains people to stage past it.
writes_snapshot="$(git rev-parse --git-path sdlc-repo-writes 2>/dev/null || true)"
[ -n "$writes_snapshot" ] || writes_snapshot="$(git rev-parse --git-dir 2>/dev/null)/sdlc-repo-writes"
rm -f "$writes_snapshot" 2>/dev/null
# The FALLBACK for a gate.py that prints no sentinel (an old or stubbed one): a coarse match over
# the staged paths, and a match runs everything.
test_relevant='(^|[[:space:]])(\.claude/skills/sdlc-studio/scripts/|\.claude/skills/sdlc-studio/templates/|tools/)'
suites_needed=0
suite_skip=""
decision_out=""
# Only when the commit is still viable: once a cheaper lane has failed it is blocked either way,
# so the selection sits UNDER the `$fail -eq 0` guard.
if [ "$fail" -eq 0 ]; then
  decision_out="$(python3 "$skill/gate.py" --root . --suite-decision --staged 2>/dev/null)"
  case "$decision_out" in
    *"suite-decision: run"*) suites_needed=1 ;;
    *"suite-decision: skip"*)
      suite_skip="$(printf '%s\n' "$decision_out" | sed -n 's/^suite-decision: skip - //p' | head -1)"
      [ -n "$suite_skip" ] || suite_skip="the staged change reaches no test module"
      ;;
    *) git diff --cached --name-only | grep -qE "$test_relevant" && suites_needed=1 ;;
  esac
fi
if [ "$fail" -eq 0 ] && [ "$suites_needed" -eq 1 ]; then
  # This hook's seconds travel with the record, so the elapsed time commit-msg reports against
  # the budget covers BOTH hooks rather than only the half that runs last. The SELECTION travels
  # too: commit-msg is where the suites run, so a selection not handed over is one nothing uses.
  # Written in ONE redirection so an unwritable handover still fails the way it always did: the
  # refusal below is load-bearing, because a handover that cannot be written means the suites
  # never run at all, and a silently unrunnable lane inside a green gate is the coverage loss
  # every named skip here exists to prevent.
  if {
       printf 'precommit_seconds=%s\n' "$SECONDS"
       printf '%s\n' "$decision_out" | sed -n 's/^suite-selector: /suite-selector=/p'
     } > "$handoff" 2>/dev/null; then
    printf '  %snote%s unit suites selected - they run in the commit-msg hook, after the commit\n' "$Y" "$N"
    printf '       message rules, so a message defect is refused in seconds instead of after them.\n'
    # THE BEFORE HALF OF THE REPO-WRITES LANE. Running the tests must not modify a tracked file,
    # create an untracked one, or touch gitignored `sdlc-studio/.local/` - an invariant broken
    # four times in two days, each time caught by an unrelated gate rather than by the author,
    # and once destroying 23 mutation registrations nothing could restore. `commit-msg` takes
    # the second reading once the suites have finished and refuses on any difference.
    #
    # It sits INSIDE the selection block deliberately: a snapshot with no suite run between its
    # two halves is evidence of nothing, and taking one on every commit would charge a
    # docs-only commit for a question nobody asked. Cost is one `git status` plus a walk of
    # `.local/`, paid twice, on a commit that was already paying for the suites.
    #
    # A failure here is NAMED and does not block. The snapshot is unavailable in exactly one
    # situation - a tree without the checker, which is every hook fixture in this repo's own
    # suite - and refusing those would make the gate untestable. `check` refuses on a missing
    # record, so a snapshot that silently failed cannot read as a clean comparison either.
    #
    # The RECORD is what decides, not the exit code. A stub checker exits 0 and writes nothing,
    # and reading only the status would leave the lane un-runnable AND unmentioned - the silent
    # skip this hook names every other skip to avoid.
    if python3 tools/repo_writes.py snapshot --root . --out "$writes_snapshot" 2>/dev/null \
       && [ -s "$writes_snapshot" ]; then
      :
    else
      rm -f "$writes_snapshot" 2>/dev/null
      printf '  %sSKIP%s repo-writes - the working tree could not be snapshotted, so whether the\n' "$Y" "$N"
      printf '       suites write into it will NOT be checked for this commit.\n'
    fi
  else
    # A handover that cannot be written means the suites will not run at all. Refused, not
    # warned: an unrunnable expensive lane inside an otherwise green gate is the silent
    # coverage loss every named skip in this hook exists to prevent.
    fail=1
    printf '  %sFAIL%s %ssuite-handover%s\n' "$R" "$N" "$B" "$N"
    printf '       enforces: the unit suites run in the commit-msg hook, and this hook hands the\n'
    printf '                 selection over in %s\n' "$handoff"
    printf '       %s-> fix:%s make the git directory writable, then commit again.\n\n' "$B" "$N"
  fi
elif [ "$fail" -ne 0 ]; then
  printf '  %sSKIP%s unit suites - a cheaper lane already failed, so the commit is blocked either way.\n' "$Y" "$N"
  printf '       Fix the failure above and commit again; the suites run once the cheap guards are green.\n'
elif [ -n "$suite_skip" ]; then
  # Named, like every other skip in this hook: nothing the commit touches is tested per commit,
  # or a green verdict already covers this exact tree. Either way the reason is printed.
  printf '  %sSKIP%s unit suites - %s\n' "$Y" "$N" "$suite_skip"
else
  printf '  %sSKIP%s unit suites - no test-relevant file staged (gate.py gave no selection, so a\n' "$Y" "$N"
  printf '       path match decided). Style, links, budgets, markdown and the artefact gate still ran.\n'
fi

if [ "$fail" -ne 0 ]; then
  printf '\n%sCommit blocked.%s Fix the failures above (each lists how), then commit again.\n' "$R" "$N"
  printf 'Genuine emergency only: %sgit commit --no-verify%s\n' "$B" "$N"
  # A blocked commit never reaches commit-msg, so neither record may survive it. The snapshot
  # goes with the handover: a record left behind would describe a tree from a run that never
  # happened, and the next commit-msg-only operation would compare against it.
  rm -f "$handoff" "$writes_snapshot" 2>/dev/null
  exit 1
fi
# Honest about what is still owed: "green" over a gate whose expensive half has not run yet
# would read as a finished verdict.
if [ -e "$handoff" ]; then
  printf '%scheap lanes green.%s Commit-message rules next, then the unit suites.\n' "$G" "$N"
else
  printf '%sgate green.%s\n' "$G" "$N"
fi
exit 0
