    {
      "key": "goal",
      "title": "Sprint goal",
      "figures": {
        "sprint_goal": {
          "key": "sprint_goal",
          "value": "Every recorded fact the close relies on is read by the machinery rather than by a human, and a sprint goal becomes a contract the close executes. Clause 1: a fact recorded on an artefact is joined to its current source before the close acts on it, so a criterion self-reporting a miss is not counted satisfied, a stop-ship ruling is re-judged against its finding's status rather than blocking forever, and a finding stamped with prose rather than a date is never attributed to a run by that stamp. Clause 2: the report of record discloses what the signer cannot otherwise know, namely the waivers that permitted the seal and the count of operator rulings against persona rulings. Clause 3: a backlog guard is proved against this repository's own corpus and not only a fixture, so the abandoned-request path reports a non-zero count where the shipped lens reports zero. Clause 4: a goal is authored as numbered clauses each carrying a check, a goal carrying none is refused at plan time, a check that cannot run reports unknown rather than green, and the close derives its verdict from running them with any author override recorded beside the derived value it disagrees with, and the report of record carries each clause with its own verdict and evidence.",
          "source": "sdlc-studio/.local/run-state.json"
        },
        "goal_verdict": {
          "key": "goal_verdict",
          "value": "Judged partial",
          "source": "sdlc-studio/.local/run-state.json"
        },
        "goal_verdict_note": {
          "key": "goal_verdict_note",
          "value": "Clauses 1-3 delivered in full; Clause 4 - a goal authored as checked clauses with a derived verdict - NOT attempted, dropped to the next run with EP0258 intact under D0250. This verdict is ASSERTED by its author because nothing yet derives it, which is exactly what Clause 4 exists to end.",
          "source": "sdlc-studio/.local/run-state.json"
        }
      },
